# Copy to .env and fill in. NEVER commit .env. Use a DEMO account only.
TB_MODE=backtest            # backtest | paper
TB_LOG_LEVEL=INFO
TB_DATA_DIR=data_store
TB_OUTPUT_DIR=outputs

# MetaTrader 5 demo account (needed from the data/paper milestones onward)
TB_MT5_LOGIN=
TB_MT5_PASSWORD=
TB_MT5_SERVER=
TB_MT5_PATH=                # optional: path to terminal64.exe
